import React, { useState, useEffect } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getFirestore, 
  collection, 
  doc, 
  addDoc, 
  onSnapshot, 
  deleteDoc, 
  getDocs 
} from 'firebase/firestore';
import { 
  getAuth, 
  signInAnonymously, 
  signInWithCustomToken, 
  onAuthStateChanged 
} from 'firebase/auth';
import { 
  QrCode, 
  Users, 
  RotateCcw, 
  Euro, 
  AlertTriangle, 
  MessageSquare, 
  Presentation, 
  Smartphone,
  ChevronRight,
  ChevronLeft,
  CheckCircle2,
  Target,
  Coins,
  Share2,
  Copy,
  Check,
  ShieldCheck,
  ExternalLink
} from 'lucide-react';

// ==========================================
// 1. FIREBASE SETUP & INITIALIZATION
// ==========================================
const firebaseConfig = typeof __firebase_config !== 'undefined'
  ? JSON.parse(__firebase_config)
  : {
      apiKey: "demo-api-key",
      authDomain: "bni-survey-demo.firebaseapp.com",
      projectId: "bni-survey-demo",
      storageBucket: "bni-survey-demo.appspot.com",
      messagingSenderId: "123456789",
      appId: "1:123456789:web:demo"
    };

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'bni-live-discussion-app-v3';

// ==========================================
// 2. DATA DEFINITIONS & OPTIONS
// ==========================================
const REVENUE_BRACKETS = [
  { id: 'under_100k', label: '< 100.000 €' },
  { id: '100k_250k', label: '100.000 € - 250.000 €' },
  { id: '250k_500k', label: '250.000 € - 500.000 €' },
  { id: '500k_1m', label: '500.000 € - 1.000.000 €' },
  { id: 'above_1m', label: '> 1.000.000 €' }
];

const COLLABORATION_MODELS = [
  { id: 'festpreis', label: 'Festpreis per Projekt', desc: 'Pauschale Abrechnung nach Leistung' },
  { id: 'stunde', label: 'Stunden-/Tagessatz', desc: 'Abrechnung nach tatsächlichem Zeitaufwand' },
  { id: 'rahmenvertrag', label: 'Rahmenvertrag', desc: 'Wiederkehrende Dienstleistung & Pauschale' },
  { id: 'provision', label: 'Provisionsmodell / Kickback', desc: 'Erfolgsabhängige Vergütung bei Empfehlungen' }
];

const HURDLES = [
  { id: 'target_group', label: 'Unklarheit über die exakte Zielgruppe / Preise des Partners' },
  { id: 'synergies', label: 'Zu wenige direkte Schnittstellen im Chapter' },
  { id: 'margins', label: 'Fehlendes klares Rabatt- oder Provisionsangebot unter Partnern' },
  { id: 'time', label: 'Zeitmangel für intensive 1-zu-1 Strategiegespräche' },
  { id: 'quality', label: 'Angst vor Qualitätsrisiko bei Weiterempfehlung' }
];

export default function App() {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('survey'); // 'survey' | 'presentation'
  const [submissions, setSubmissions] = useState([]);
  const [loading, setLoading] = useState(true);
  const [submitting, setSubmitting] = useState(false);
  const [submitted, setSubmitted] = useState(false);
  const [currentStep, setCurrentStep] = useState(0);
  const [copiedLink, setCopiedLink] = useState(false);
  const [copiedText, setCopiedText] = useState(false);

  // Form State (9 Anonymized Questions)
  const [answers, setAnswers] = useState({
    annualRevenue: '',          // Q1
    hourlyRate: 95,             // Q2 (€)
    fairMemberPricingType: 'percent', // 'percent' | 'stundensatz' (Q3)
    fairMemberValue: 10,        // Q3 value (e.g. 10% or 80€)
    annualNetworkPotential: 30000, // Q4 (€)
    collaborationModel: '',     // Q5
    idealTicketSize: 5000,      // Q6 (€)
    hurdle: '',                 // Q7
    targetExtraEarnings: 20000, // Q8 (€)
    impulseOffer: ''            // Q9 Freitext
  });
  const [validationError, setValidationError] = useState('');

  // Current URL for sharing
  const shareUrl = typeof window !== 'undefined' ? window.location.href : 'https://bni.de';
  
  const whatsappInviteText = `👋 Hallo Zusammen!\n\nFür unser heutiges BNI-Meeting machen wir eine kurze, *100% anonyme Live-Umfrage* zu Preisen, Stundensätzen & Kooperationen im Chapter.\n\nDauert unter 60 Sekunden! Macht alle direkt am Smartphone mit, damit wir gleich die Live-Ergebnisse auf dem Beamer besprechen können:\n\n👉 ${shareUrl}`;

  // ------------------------------------------
  // AUTHENTICATION EFFECT
  // ------------------------------------------
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth initialization error:", err);
      }
    };
    initAuth();

    const unsubscribe = onAuthStateChanged(auth, (usr) => {
      setUser(usr);
    });
    return () => unsubscribe();
  }, []);

  // ------------------------------------------
  // REAL-TIME FIRESTORE DATA LISTENER
  // ------------------------------------------
  useEffect(() => {
    if (!user) return;

    const submissionsRef = collection(db, 'artifacts', appId, 'public', 'data', 'bni_submissions_v3');

    const unsubscribe = onSnapshot(
      submissionsRef,
      (snapshot) => {
        const data = snapshot.docs.map(docSnap => ({
          id: docSnap.id,
          ...docSnap.data()
        }));
        setSubmissions(data);
        setLoading(false);
      },
      (error) => {
        console.error("Firestore onSnapshot error:", error);
        setLoading(false);
      }
    );

    return () => unsubscribe();
  }, [user]);

  // ------------------------------------------
  // HANDLERS
  // ------------------------------------------
  const handleNext = () => {
    if (currentStep === 0 && !answers.annualRevenue) {
      setValidationError('Bitte wähle deinen aktuellen Jahresumsatz aus.');
      return;
    }
    if (currentStep === 4 && !answers.collaborationModel) {
      setValidationError('Bitte wähle dein bevorzugtes Kooperationsmodell.');
      return;
    }
    if (currentStep === 6 && !answers.hurdle) {
      setValidationError('Bitte wähle deine größte Hürde aus.');
      return;
    }

    setValidationError('');
    if (currentStep < 8) {
      setCurrentStep(prev => prev + 1);
    } else {
      handleSubmitSurvey();
    }
  };

  const handlePrev = () => {
    setValidationError('');
    if (currentStep > 0) {
      setCurrentStep(prev => prev - 1);
    }
  };

  const handleSubmitSurvey = async () => {
    if (!user) return;
    setSubmitting(true);
    try {
      const submissionsRef = collection(db, 'artifacts', appId, 'public', 'data', 'bni_submissions_v3');
      await addDoc(submissionsRef, {
        answers,
        createdAt: new Date().toISOString(),
        userId: user.uid
      });
      setSubmitted(true);
    } catch (err) {
      console.error("Error submitting response:", err);
      alert("Fehler beim Absenden. Bitte versuche es erneut.");
    } finally {
      setSubmitting(false);
    }
  };

  const handleResetAllData = async () => {
    if (!user) return;
    if (window.confirm("Möchtest du alle Umfragedaten für ein neues Meeting zurücksetzen?")) {
      try {
        const submissionsRef = collection(db, 'artifacts', appId, 'public', 'data', 'bni_submissions_v3');
        const snapshot = await getDocs(submissionsRef);
        const deletePromises = snapshot.docs.map(docSnap => 
          deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'bni_submissions_v3', docSnap.id))
        );
        await Promise.all(deletePromises);
        alert("Daten wurden zurückgesetzt!");
      } catch (err) {
        console.error("Error deleting docs:", err);
      }
    }
  };

  const copyToClipboard = (text, setCopiedState) => {
    navigator.clipboard.writeText(text);
    setCopiedState(true);
    setTimeout(() => setCopiedState(false), 2500);
  };

  const shareViaWhatsApp = () => {
    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(whatsappInviteText)}`;
    window.open(url, '_blank');
  };

  // ------------------------------------------
  // STATISTICAL CALCULATIONS FOR BEAMER
  // ------------------------------------------
  const totalCount = submissions.length;

  const totalNetworkPotential = submissions.reduce((sum, item) => sum + (Number(item.answers?.annualNetworkPotential) || 0), 0);
  const totalTargetExtraEarnings = submissions.reduce((sum, item) => sum + (Number(item.answers?.targetExtraEarnings) || 0), 0);
  
  const avgHourlyRate = totalCount > 0 
    ? Math.round(submissions.reduce((sum, item) => sum + (Number(item.answers?.hourlyRate) || 0), 0) / totalCount)
    : 0;

  const percentDiscounts = submissions.filter(s => s.answers?.fairMemberPricingType === 'percent');
  const avgMemberDiscount = percentDiscounts.length > 0
    ? Math.round((percentDiscounts.reduce((sum, item) => sum + (Number(item.answers?.fairMemberValue) || 0), 0) / percentDiscounts.length) * 10) / 10
    : 0;

  const modelCounts = submissions.reduce((acc, curr) => {
    const mod = curr.answers?.collaborationModel;
    if (mod) acc[mod] = (acc[mod] || 0) + 1;
    return acc;
  }, {});

  const hurdleCounts = submissions.reduce((acc, curr) => {
    const h = curr.answers?.hurdle;
    if (h) acc[h] = (acc[h] || 0) + 1;
    return acc;
  }, {});

  const revenueBracketCounts = submissions.reduce((acc, curr) => {
    const rev = curr.answers?.annualRevenue;
    if (rev) acc[rev] = (acc[rev] || 0) + 1;
    return acc;
  }, {});

  const qrCodeUrl = `https://quickchart.io/qr?text=${encodeURIComponent(shareUrl)}&size=250&dark=CF142B`;

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 font-sans flex flex-col">
      {/* HEADER */}
      <header className="bg-[#CF142B] text-white shadow-xl sticky top-0 z-50">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          <div className="flex items-center space-x-3">
            <div className="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center font-black text-xl tracking-tighter shadow-inner">
              BNI
            </div>
            <div>
              <h1 className="font-bold text-base sm:text-lg leading-none">Preise & Umsatz Live-Umfrage</h1>
              <p className="text-xs text-white/80 font-medium mt-0.5 flex items-center space-x-1">
                <ShieldCheck className="w-3 h-3 text-emerald-300" />
                <span>100% Anonyme Chapter-Erhebung</span>
              </p>
            </div>
          </div>

          <div className="flex bg-black/20 p-1 rounded-xl border border-white/10">
            <button
              onClick={() => setActiveTab('survey')}
              className={`flex items-center space-x-2 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all ${
                activeTab === 'survey' ? 'bg-white text-[#CF142B] shadow-md' : 'text-white/80 hover:text-white'
              }`}
            >
              <Smartphone className="w-4 h-4" />
              <span className="hidden sm:inline">Mitglied (Handy)</span>
              <span className="sm:hidden">Umfrage</span>
            </button>
            <button
              onClick={() => setActiveTab('presentation')}
              className={`flex items-center space-x-2 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all ${
                activeTab === 'presentation' ? 'bg-white text-[#CF142B] shadow-md' : 'text-white/80 hover:text-white'
              }`}
            >
              <Presentation className="w-4 h-4" />
              <span className="hidden sm:inline">Beamer / Live</span>
              <span className="sm:hidden">Beamer</span>
              <span className="ml-1 px-2 py-0.5 text-xs bg-[#CF142B] text-white rounded-full font-bold">
                {totalCount}
              </span>
            </button>
          </div>
        </div>
      </header>

      {/* MAIN CONTENT */}
      <main className="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col justify-start">
        
        {/* ========================================== */}
        {/* TAB 1: 9 ANONYMOUS MEMBER SURVEY QUESTIONS */}
        {/* ========================================== */}
        {activeTab === 'survey' && (
          <div className="max-w-xl mx-auto w-full py-2">
            {!submitted ? (
              <div className="bg-slate-800 border border-slate-700/80 rounded-2xl shadow-2xl overflow-hidden">
                <div className="bg-slate-900/60 p-4 border-b border-slate-700 flex items-center justify-between text-xs font-semibold text-slate-400">
                  <span>Frage {currentStep + 1} von 9</span>
                  <span className="flex items-center space-x-1 text-emerald-400">
                    <ShieldCheck className="w-3.5 h-3.5" />
                    <span>Anonym</span>
                  </span>
                </div>
                <div className="w-full bg-slate-700 h-1.5">
                  <div 
                    className="bg-[#CF142B] h-full transition-all duration-300"
                    style={{ width: `${((currentStep + 1) / 9) * 100}%` }}
                  />
                </div>

                <div className="p-6 sm:p-8">
                  {/* Q1: ANNUAL REVENUE */}
                  {currentStep === 0 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        1. Jahresumsatz deines Unternehmens
                      </h2>
                      <p className="text-sm text-slate-400 mb-6">In welchem Bereich liegt dein geschätzter Jahresumsatz?</p>
                      <div className="space-y-3">
                        {REVENUE_BRACKETS.map(rev => (
                          <button
                            key={rev.id}
                            type="button"
                            onClick={() => {
                              setAnswers(prev => ({ ...prev, annualRevenue: rev.id }));
                              setValidationError('');
                            }}
                            className={`w-full text-left p-4 rounded-xl border-2 flex items-center justify-between transition-all ${
                              answers.annualRevenue === rev.id
                                ? 'border-[#CF142B] bg-[#CF142B]/10 text-white font-semibold'
                                : 'border-slate-700 bg-slate-800 hover:bg-slate-750 text-slate-300'
                            }`}
                          >
                            <span>{rev.label}</span>
                            <div className={`w-5 h-5 rounded-full border-2 flex items-center justify-center ${
                              answers.annualRevenue === rev.id ? 'border-[#CF142B] bg-[#CF142B]' : 'border-slate-600'
                            }`}>
                              {answers.annualRevenue === rev.id && <div className="w-2 h-2 rounded-full bg-white" />}
                            </div>
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Q2: HOURLY RATE */}
                  {currentStep === 1 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        2. Dein kalkulierter Stundensatz (€)
                      </h2>
                      <p className="text-sm text-slate-400 mb-6">
                        Welchen regulären Stundensatz kalkulierst du üblicherweise in deinem Geschäft?
                      </p>
                      <div className="bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center mb-6 shadow-inner">
                        <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Stundensatz</span>
                        <div className="text-4xl font-extrabold text-[#CF142B]">{answers.hourlyRate} € / Std.</div>
                      </div>
                      <input 
                        type="range"
                        min="30"
                        max="350"
                        step="5"
                        value={answers.hourlyRate}
                        onChange={(e) => setAnswers(prev => ({ ...prev, hourlyRate: Number(e.target.value) }))}
                        className="w-full h-3 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-[#CF142B]"
                      />
                      <div className="flex justify-between text-xs text-slate-400 font-semibold mt-2">
                        <span>30 €</span>
                        <span>150 €</span>
                        <span>350 €+</span>
                      </div>
                    </div>
                  )}

                  {/* Q3: FAIR MEMBER PRICING / DISCOUNT */}
                  {currentStep === 2 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        3. Fairer BNI-Mitgliederpreis / Vorteils-Modell
                      </h2>
                      <p className="text-sm text-slate-400 mb-4">
                        Wie gestaltet sich ein fairer Vorteil für BNI-Partner in deinem Geschäft?
                      </p>
                      
                      <div className="flex bg-slate-900 p-1 rounded-xl mb-6 border border-slate-700">
                        <button
                          type="button"
                          onClick={() => setAnswers(prev => ({ ...prev, fairMemberPricingType: 'percent', fairMemberValue: 10 }))}
                          className={`flex-1 py-2 text-xs font-semibold rounded-lg transition-all ${
                            answers.fairMemberPricingType === 'percent' ? 'bg-[#CF142B] text-white shadow' : 'text-slate-400'
                          }`}
                        >
                          Prozent-Rabatt / Provision (%)
                        </button>
                        <button
                          type="button"
                          onClick={() => setAnswers(prev => ({ ...prev, fairMemberPricingType: 'stundensatz', fairMemberValue: 80 }))}
                          className={`flex-1 py-2 text-xs font-semibold rounded-lg transition-all ${
                            answers.fairMemberPricingType === 'stundensatz' ? 'bg-[#CF142B] text-white shadow' : 'text-slate-400'
                          }`}
                        >
                          BNI-Partner-Stundensatz (€)
                        </button>
                      </div>

                      {answers.fairMemberPricingType === 'percent' ? (
                        <div>
                          <div className="bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center mb-6">
                            <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">BNI-Vorteil / Rabatt</span>
                            <div className="text-4xl font-extrabold text-[#CF142B]">{answers.fairMemberValue} %</div>
                          </div>
                          <input 
                            type="range"
                            min="0"
                            max="30"
                            step="1"
                            value={answers.fairMemberValue}
                            onChange={(e) => setAnswers(prev => ({ ...prev, fairMemberValue: Number(e.target.value) }))}
                            className="w-full h-3 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-[#CF142B]"
                          />
                          <div className="flex justify-between text-xs text-slate-400 font-semibold mt-2">
                            <span>0% (Standard)</span>
                            <span>15%</span>
                            <span>30% (Partnerpreis)</span>
                          </div>
                        </div>
                      ) : (
                        <div>
                          <div className="bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center mb-6">
                            <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Spezieller Partner-Stundensatz</span>
                            <div className="text-4xl font-extrabold text-[#CF142B]">{answers.fairMemberValue} € / Std.</div>
                          </div>
                          <input 
                            type="range"
                            min="30"
                            max="300"
                            step="5"
                            value={answers.fairMemberValue}
                            onChange={(e) => setAnswers(prev => ({ ...prev, fairMemberValue: Number(e.target.value) }))}
                            className="w-full h-3 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-[#CF142B]"
                          />
                        </div>
                      )}
                    </div>
                  )}

                  {/* Q4: ANNUAL NETWORK POTENTIAL */}
                  {currentStep === 3 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        4. Umsatzpotenzial im BNI-Netzwerk (€)
                      </h2>
                      <p className="text-sm text-slate-400 mb-6">
                        Welches Umsatzpotenzial siehst du jährlich durch Kooperationen & Empfehlungen im Chapter?
                      </p>
                      <div className="bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center mb-6">
                        <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Potenzial pro Jahr</span>
                        <div className="text-3xl sm:text-4xl font-extrabold text-[#CF142B]">{answers.annualNetworkPotential.toLocaleString('de-DE')} €</div>
                      </div>
                      <input 
                        type="range"
                        min="5000"
                        max="200000"
                        step="5000"
                        value={answers.annualNetworkPotential}
                        onChange={(e) => setAnswers(prev => ({ ...prev, annualNetworkPotential: Number(e.target.value) }))}
                        className="w-full h-3 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-[#CF142B]"
                      />
                      <div className="flex justify-between text-xs text-slate-400 font-semibold mt-2">
                        <span>5.000 €</span>
                        <span>100.000 €</span>
                        <span>200.000 €+</span>
                      </div>
                    </div>
                  )}

                  {/* Q5: PREFERRED COLLABORATION MODEL */}
                  {currentStep === 4 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        5. Kooperationsmodell – Was wünscht ihr euch?
                      </h2>
                      <p className="text-sm text-slate-400 mb-6">Wie möchtest du am liebsten mit anderen BNI-Partnern zusammenarbeiten?</p>
                      <div className="space-y-3">
                        {COLLABORATION_MODELS.map(model => (
                          <button
                            key={model.id}
                            type="button"
                            onClick={() => {
                              setAnswers(prev => ({ ...prev, collaborationModel: model.id }));
                              setValidationError('');
                            }}
                            className={`w-full text-left p-4 rounded-xl border-2 transition-all ${
                              answers.collaborationModel === model.id
                                ? 'border-[#CF142B] bg-[#CF142B]/10 text-white'
                                : 'border-slate-700 bg-slate-800 hover:bg-slate-750 text-slate-300'
                            }`}
                          >
                            <div className="font-semibold text-base">{model.label}</div>
                            <div className="text-xs text-slate-400 mt-1">{model.desc}</div>
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Q6: IDEAL TICKET SIZE */}
                  {currentStep === 5 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        6. Idealer Auftragswert (Ticket Size)
                      </h2>
                      <p className="text-sm text-slate-400 mb-6">Welche durchschnittliche Auftragsgröße (€) ist für dich ideal?</p>
                      <div className="bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center mb-6">
                        <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Ideal-Auftrag</span>
                        <div className="text-3xl sm:text-4xl font-extrabold text-[#CF142B]">{answers.idealTicketSize.toLocaleString('de-DE')} €</div>
                      </div>
                      <input 
                        type="range"
                        min="500"
                        max="50000"
                        step="500"
                        value={answers.idealTicketSize}
                        onChange={(e) => setAnswers(prev => ({ ...prev, idealTicketSize: Number(e.target.value) }))}
                        className="w-full h-3 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-[#CF142B]"
                      />
                      <div className="flex justify-between text-xs text-slate-400 font-semibold mt-2">
                        <span>500 €</span>
                        <span>25.000 €</span>
                        <span>50.000 €+</span>
                      </div>
                    </div>
                  )}

                  {/* Q7: GREATEST HURDLE */}
                  {currentStep === 6 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        7. Größte Hürde bei der Vergabe
                      </h2>
                      <p className="text-sm text-slate-400 mb-6">Was hält dich davon ab, mehr Geschäft im Chapter zu vergeben?</p>
                      <div className="space-y-3">
                        {HURDLES.map(h => (
                          <button
                            key={h.id}
                            type="button"
                            onClick={() => {
                              setAnswers(prev => ({ ...prev, hurdle: h.id }));
                              setValidationError('');
                            }}
                            className={`w-full text-left p-4 rounded-xl border-2 transition-all ${
                              answers.hurdle === h.id
                                ? 'border-[#CF142B] bg-[#CF142B]/10 text-white font-semibold'
                                : 'border-slate-700 bg-slate-800 hover:bg-slate-750 text-slate-300'
                            }`}
                          >
                            <span className="text-sm sm:text-base">{h.label}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Q8: TARGET EXTRA EARNINGS */}
                  {currentStep === 7 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        8. Gewünschter Zusatzverdienst pro Jahr
                      </h2>
                      <p className="text-sm text-slate-400 mb-6">Wie viel Mehrwert/Zusatzgewinn erwartest du pro Jahr durch BNI?</p>
                      <div className="bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center mb-6">
                        <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Gewünschter Mehrwert</span>
                        <div className="text-3xl sm:text-4xl font-extrabold text-emerald-400">{answers.targetExtraEarnings.toLocaleString('de-DE')} €</div>
                      </div>
                      <input 
                        type="range"
                        min="2500"
                        max="100000"
                        step="2500"
                        value={answers.targetExtraEarnings}
                        onChange={(e) => setAnswers(prev => ({ ...prev, targetExtraEarnings: Number(e.target.value) }))}
                        className="w-full h-3 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500"
                      />
                      <div className="flex justify-between text-xs text-slate-400 font-semibold mt-2">
                        <span>2.500 €</span>
                        <span>50.000 €</span>
                        <span>100.000 €+</span>
                      </div>
                    </div>
                  )}

                  {/* Q9: IMPULSE OFFER */}
                  {currentStep === 8 && (
                    <div>
                      <h2 className="text-xl sm:text-2xl font-bold text-white mb-2">
                        9. Angebot oder Gesuch für die Diskussion heute
                      </h2>
                      <p className="text-sm text-slate-400 mb-4">
                        Welche konkrete Leistung möchtest du heute den anderen anbieten oder anfragen? (Anonym für den Beamer)
                      </p>
                      <textarea
                        rows={4}
                        value={answers.impulseOffer}
                        onChange={(e) => setAnswers(prev => ({ ...prev, impulseOffer: e.target.value }))}
                        placeholder="Z.B.: Suche Baupartner für Großprojekt oder biete 10% Sonderkondition auf IT-Systemprüfungen..."
                        className="w-full p-4 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:border-[#CF142B] outline-none text-sm"
                      />
                    </div>
                  )}

                  {validationError && (
                    <div className="mt-4 p-3 bg-rose-500/10 border border-rose-500/30 text-rose-400 rounded-xl text-xs font-semibold flex items-center space-x-2">
                      <AlertTriangle className="w-4 h-4 flex-shrink-0" />
                      <span>{validationError}</span>
                    </div>
                  )}
                </div>

                <div className="px-6 py-4 bg-slate-900/60 border-t border-slate-700 flex justify-between items-center">
                  <button
                    onClick={handlePrev}
                    disabled={currentStep === 0}
                    className={`px-4 py-2 rounded-xl text-sm font-semibold flex items-center space-x-1 ${
                      currentStep === 0 ? 'opacity-0 pointer-events-none' : 'text-slate-400 hover:text-white'
                    }`}
                  >
                    <ChevronLeft className="w-4 h-4" />
                    <span>Zurück</span>
                  </button>

                  <button
                    onClick={handleNext}
                    disabled={submitting}
                    className="bg-[#CF142B] hover:bg-[#b01024] text-white px-6 py-2.5 rounded-xl font-semibold shadow-lg shadow-[#CF142B]/30 flex items-center space-x-2 text-sm transition-transform active:scale-95"
                  >
                    <span>{currentStep === 8 ? (submitting ? 'Sendet...' : 'Anonym Absenden') : 'Weiter'}</span>
                    <ChevronRight className="w-4 h-4" />
                  </button>
                </div>
              </div>
            ) : (
              <div className="bg-slate-800 border border-slate-700 rounded-2xl p-8 text-center shadow-2xl space-y-6">
                <div className="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto">
                  <CheckCircle2 className="w-10 h-10" />
                </div>
                <div>
                  <h2 className="text-2xl font-bold text-white mb-2">Vielen Dank für deine Eingabe!</h2>
                  <p className="text-slate-400 text-sm">
                    Deine Daten wurden 100% anonym an das Beamer-Dashboard übertragen.
                  </p>
                </div>

                {/* WHATSAPP SHARE CARD FOR MEMBERS */}
                <div className="bg-slate-900 p-5 rounded-xl border border-slate-700 text-left space-y-3">
                  <div className="flex items-center space-x-2 text-emerald-400 font-semibold text-sm">
                    <Share2 className="w-4 h-4" />
                    <span>In WhatsApp-Gruppe teilen</span>
                  </div>
                  <p className="text-xs text-slate-400">
                    Teile den Umfrage-Link direkt in eurer BNI-WhatsApp-Gruppe, damit noch mehr Mitglieder mitmachen:
                  </p>
                  <button
                    onClick={shareViaWhatsApp}
                    className="w-full bg-[#25D366] hover:bg-[#20bd5a] text-black font-bold py-3 px-4 rounded-xl flex items-center justify-center space-x-2 text-sm shadow-lg transition-transform active:scale-95"
                  >
                    <MessageSquare className="w-5 h-5 fill-current" />
                    <span>WhatsApp Einladung Senden</span>
                  </button>
                </div>

                <button
                  onClick={() => setActiveTab('presentation')}
                  className="bg-slate-700 hover:bg-slate-600 text-white px-6 py-3 rounded-xl font-semibold text-sm inline-flex items-center space-x-2 border border-slate-600"
                >
                  <Presentation className="w-4 h-4 text-[#CF142B]" />
                  <span>Beamer-Ergebnisse Ansehen</span>
                </button>
              </div>
            )}
          </div>
        )}

        {/* ========================================== */}
        {/* TAB 2: BEAMER & WHATSAPP SHARING DASHBOARD */}
        {/* ========================================== */}
        {activeTab === 'presentation' && (
          <div className="space-y-6">
            
            {/* TOP HEADER: QR CODE & WHATSAPP COPY BOX */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              
              {/* QR CODE CARD */}
              <div className="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl flex items-center space-x-6">
                <div className="bg-white p-2 rounded-xl shadow-md flex-shrink-0">
                  <img src={qrCodeUrl} alt="Scan QR" className="w-28 h-28" />
                </div>
                <div>
                  <div className="inline-flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-3 py-1 rounded-full text-xs font-semibold mb-2">
                    <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                    <span>Live-Erhebung</span>
                  </div>
                  <h2 className="text-xl font-black text-white">Handy Scannen</h2>
                  <p className="text-xs text-slate-400 mt-1">
                    Kamera aufs Display halten & direkt anonym abstimmen!
                  </p>
                </div>
              </div>

              {/* WHATSAPP SHARE CARD */}
              <div className="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl lg:col-span-2 flex flex-col justify-between space-y-4">
                <div className="flex items-start justify-between">
                  <div>
                    <h3 className="text-base font-bold text-white flex items-center space-x-2">
                      <MessageSquare className="w-5 h-5 text-[#25D366]" />
                      <span>WhatsApp Einladungs-Text fürs Chapter</span>
                    </h3>
                    <p className="text-xs text-slate-400 mt-0.5">
                      Direkt in die WhatsApp-Gruppe kopieren oder teilen:
                    </p>
                  </div>
                  <button
                    onClick={handleResetAllData}
                    className="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-xl text-xs font-semibold flex items-center space-x-1.5 transition-colors border border-slate-600 flex-shrink-0"
                  >
                    <RotateCcw className="w-3.5 h-3.5 text-rose-400" />
                    <span>Reset</span>
                  </button>
                </div>

                <div className="flex flex-col sm:flex-row gap-3">
                  <button
                    onClick={shareViaWhatsApp}
                    className="flex-1 bg-[#25D366] hover:bg-[#20bd5a] text-black font-bold py-2.5 px-4 rounded-xl flex items-center justify-center space-x-2 text-xs sm:text-sm shadow-md transition-all"
                  >
                    <MessageSquare className="w-4 h-4 fill-current" />
                    <span>Direkt bei WhatsApp öffnen</span>
                  </button>

                  <button
                    onClick={() => copyToClipboard(shareUrl, setCopiedLink)}
                    className="bg-slate-700 hover:bg-slate-600 text-white font-semibold py-2.5 px-4 rounded-xl flex items-center justify-center space-x-2 text-xs sm:text-sm border border-slate-600 transition-all"
                  >
                    {copiedLink ? <Check className="w-4 h-4 text-emerald-400" /> : <Copy className="w-4 h-4" />}
                    <span>{copiedLink ? 'Link Kopiert!' : 'Nur Link Kopieren'}</span>
                  </button>

                  <button
                    onClick={() => copyToClipboard(whatsappInviteText, setCopiedText)}
                    className="bg-slate-700 hover:bg-slate-600 text-white font-semibold py-2.5 px-4 rounded-xl flex items-center justify-center space-x-2 text-xs sm:text-sm border border-slate-600 transition-all"
                  >
                    {copiedText ? <Check className="w-4 h-4 text-emerald-400" /> : <Copy className="w-4 h-4" />}
                    <span>{copiedText ? 'Text Kopiert!' : 'Text Kopieren'}</span>
                  </button>
                </div>
              </div>
            </div>

            {/* FINANCIAL KPIS GRID */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div className="bg-slate-800 border border-slate-700 p-5 rounded-2xl flex items-center space-x-4 shadow-lg">
                <div className="p-3 bg-[#CF142B]/20 text-[#CF142B] rounded-xl">
                  <Users className="w-7 h-7" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Teilnehmer im Raum</p>
                  <p className="text-2xl font-black text-white">{totalCount}</p>
                </div>
              </div>

              <div className="bg-slate-800 border border-slate-700 p-5 rounded-2xl flex items-center space-x-4 shadow-lg">
                <div className="p-3 bg-amber-500/20 text-amber-400 rounded-xl">
                  <Coins className="w-7 h-7" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ø Stundensatz</p>
                  <p className="text-2xl font-black text-amber-400">{avgHourlyRate} € / Std.</p>
                </div>
              </div>

              <div className="bg-slate-800 border border-slate-700 p-5 rounded-2xl flex items-center space-x-4 shadow-lg">
                <div className="p-3 bg-indigo-500/20 text-indigo-400 rounded-xl">
                  <Target className="w-7 h-7" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ø BNI-Mitglieder-Rabatt</p>
                  <p className="text-2xl font-black text-indigo-400">{avgMemberDiscount} %</p>
                </div>
              </div>

              <div className="bg-slate-800 border border-slate-700 p-5 rounded-2xl flex items-center space-x-4 shadow-lg">
                <div className="p-3 bg-emerald-500/20 text-emerald-400 rounded-xl">
                  <Euro className="w-7 h-7" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Gesamt-Netzpotenzial</p>
                  <p className="text-xl sm:text-2xl font-black text-emerald-400">
                    {totalNetworkPotential.toLocaleString('de-DE')} €
                  </p>
                </div>
              </div>
            </div>

            {/* CHARTS GRID */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {/* REVENUE BRACKETS */}
              <div className="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg">
                <h3 className="font-bold text-white text-lg mb-1 flex justify-between">
                  <span>Jahresumsätze der Unternehmen</span>
                  <span className="text-xs text-slate-400 font-normal">Q1</span>
                </h3>
                <div className="space-y-3 mt-4">
                  {REVENUE_BRACKETS.map(rev => {
                    const count = revenueBracketCounts[rev.id] || 0;
                    const pct = totalCount > 0 ? Math.round((count / totalCount) * 100) : 0;
                    return (
                      <div key={rev.id}>
                        <div className="flex justify-between text-xs font-semibold mb-1">
                          <span className="text-slate-300">{rev.label}</span>
                          <span className="text-slate-400">{count} ({pct}%)</span>
                        </div>
                        <div className="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden">
                          <div className="bg-[#CF142B] h-full rounded-full transition-all duration-500" style={{ width: `${pct}%` }} />
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>

              {/* COLLABORATION MODELS */}
              <div className="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg">
                <h3 className="font-bold text-white text-lg mb-1 flex justify-between">
                  <span>Gewünschte Kooperationsmodelle</span>
                  <span className="text-xs text-slate-400 font-normal">Q5</span>
                </h3>
                <div className="space-y-3 mt-4">
                  {COLLABORATION_MODELS.map(model => {
                    const count = modelCounts[model.id] || 0;
                    const pct = totalCount > 0 ? Math.round((count / totalCount) * 100) : 0;
                    return (
                      <div key={model.id}>
                        <div className="flex justify-between text-xs font-semibold mb-1">
                          <span className="text-slate-300">{model.label}</span>
                          <span className="text-slate-400">{count} ({pct}%)</span>
                        </div>
                        <div className="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden">
                          <div className="bg-emerald-500 h-full rounded-full transition-all duration-500" style={{ width: `${pct}%` }} />
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>

              {/* HURDLES */}
              <div className="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg lg:col-span-2">
                <h3 className="font-bold text-white text-lg mb-1 flex justify-between">
                  <span>Größte Hürden bei der Vergabe unter Mitgliedern</span>
                  <span className="text-xs text-slate-400 font-normal">Q7</span>
                </h3>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                  {HURDLES.map(h => {
                    const count = hurdleCounts[h.id] || 0;
                    const pct = totalCount > 0 ? Math.round((count / totalCount) * 100) : 0;
                    return (
                      <div key={h.id} className="bg-slate-900/60 p-4 rounded-xl border border-slate-700">
                        <div className="flex justify-between text-xs font-semibold mb-2">
                          <span className="text-slate-300">{h.label}</span>
                          <span className="text-rose-400 font-bold">{count} ({pct}%)</span>
                        </div>
                        <div className="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden">
                          <div className="bg-rose-500 h-full rounded-full transition-all duration-500" style={{ width: `${pct}%` }} />
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>

            {/* FREETEXT OFFERS / IMPULSES CARDS FOR DISCUSSION */}
            <div className="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg">
              <h3 className="font-bold text-white text-lg mb-4 flex items-center space-x-2">
                <MessageSquare className="w-5 h-5 text-[#CF142B]" />
                <span>Anonyme Impulse & Angebote für die Live-Diskussion (Q9)</span>
              </h3>

              {submissions.filter(s => s.answers?.impulseOffer?.trim()).length === 0 ? (
                <div className="text-center py-8 text-slate-500 text-sm italic">
                  Noch keine Angebote/Gesuche eingegeben. Sobald Antworten gesendet werden, erscheinen sie live hier!
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {submissions
                    .filter(s => s.answers?.impulseOffer?.trim())
                    .map((item, idx) => (
                      <div key={item.id || idx} className="p-4 bg-slate-900 border border-slate-700 rounded-xl relative">
                        <p className="text-sm text-slate-200 italic">"{item.answers.impulseOffer}"</p>
                        <div className="mt-3 flex items-center justify-between text-xs text-slate-400 pt-2 border-t border-slate-800">
                          <span>Kalk. Stundensatz: {item.answers?.hourlyRate || 0} €/Std.</span>
                          <span>Mitglieder-Vorteil: {item.answers?.fairMemberValue || 0} {item.answers?.fairMemberPricingType === 'percent' ? '%' : '€'}</span>
                        </div>
                      </div>
                    ))}
                </div>
              )}
            </div>

          </div>
        )}

      </main>

      {/* FOOTER */}
      <footer className="bg-slate-950 border-t border-slate-800 py-4 text-center text-xs text-slate-500">
        BNI Live-Netlinking App &bull; Anonyme Live-Umsatzanalyse für WhatsApp & Beamer
      </footer>
    </div>
  );
}
